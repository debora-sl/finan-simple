# Neon Postgres — connection com pooling (usada pelo Prisma Client via adapter Neon em runtime)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres — connection direta (usada pelo Prisma CLI nas migrations)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Segredo forte do Better Auth (gere com: openssl rand -hex 32)
BETTER_AUTH_SECRET=""
# URL base da aplicação (em produção use a URL da Vercel, ex.: https://seu-app.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
